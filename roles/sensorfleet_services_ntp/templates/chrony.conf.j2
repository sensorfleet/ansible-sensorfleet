# Managed by Ansible - do not edit manually, changes will be overwritten

{% for item in sensorfleet_services_ntp_pools %}
pool {{ item.host }} {{ item.options }}
{% endfor %}

{% for item in sensorfleet_services_ntp_servers %}
server {{ item.host }} {{ item.options }}
{% endfor %}

keyfile /etc/chrony/chrony.keys
driftfile /var/lib/chrony/chrony.drift
logdir /var/log/chrony
maxupdateskew 100.0
rtcsync
makestep 1 3
maxdistance {{ sensorfleet_services_ntp_maxdistance }}

{% if (sensorfleet_services_ntp_pools | length == 0) and (sensorfleet_services_ntp_servers | length == 0) %}
# No external NTP pools/servers configured: chrony only serves internal
# (sensor) clients, so present the local clock as a valid reference instead
# of refusing to serve time, keeping sensors in sync with the FM's own clock.
local stratum 10
{% endif %}

allow 169.254.0.0/16

include /etc/chrony/chrony.d/*.conf

